{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eintrag der Wissensbasis (quellen.json ist eine Liste solcher Einträge)",
  "type": "object",
  "required": ["id","titel","jahr","autoren","feld","kernaussage","zahlen","baseline_fuer_qire","quantenbezug","bezug_qire_befund","stuetzt_widerspricht","volltext_gelesen","gefunden_am","welle","herkunft"],
  "additionalProperties": false,
  "properties": {
    "id": {"type":"string","pattern":"^(arXiv:\\d{4}\\.\\d{4,5}|doi:.+|url:.+)$"},
    "titel": {"type":"string","minLength":1},
    "jahr": {"type":["integer","null"]},
    "autoren": {"type":"string"},
    "feld": {"type":"array","minItems":1,"items":{"type":"string","pattern":"^(K[1-8]|N[1-8]|F[1-6])$"}},
    "kernaussage": {"type":"string","minLength":1},
    "zahlen": {"type":"array","items":{"type":"object","required":["wert","kontext","geprueft"],"additionalProperties":false,
      "properties":{"wert":{"type":"string"},"kontext":{"type":"string"},"geprueft":{"type":"boolean"}}}},
    "baseline_fuer_qire": {"type":["string","null"]},
    "quantenbezug": {"enum":["direkt","analogie","keiner"]},
    "bezug_qire_befund": {"type":"array","items":{"type":"string"}},
    "stuetzt_widerspricht": {"enum":["stuetzt","widerspricht","neutral","unklar"]},
    "volltext_gelesen": {"type":"boolean"},
    "gefunden_am": {"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "welle": {"type":"integer"},
    "herkunft": {"type":"string"}
  }
}
