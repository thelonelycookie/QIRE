# Kopie anlegen:  cp MPI/lokal.env.beispiel MPI/lokal.env   (lokal.env steht in MPI/.gitignore und gehoert NIE ins Repo)
# ALLES HIER IST ANNAHME, bis die Cluster-Dokumentation des MPI vorliegt.

# --- Zugang (nur Namen/Aliase, keine Passwoerter oder Schluessel) ---
MPI_SSH_ALIAS=mpi                    # Eintrag in ~/.ssh/config (siehe ANLEITUNG.md, Abschnitt Zugang)
MPI_ZIEL_ORDNER=/pfad/zu/qire        # Projektordner auf dem Cluster (Home oder Projekt-/Scratch-Bereich)

# --- Slurm (Namen vom Cluster erfragen) ---
SLURM_PARTITION_CPU=                 # leer = Standard-Partition
SLURM_PARTITION_GPU=
SLURM_ACCOUNT=                       # leer = nicht angeben
SLURM_GPU_ANGABE=gpu:1               # je nach Cluster z. B. gpu:a100:1 oder gres/gpu=1

# --- Software (auf dem Cluster) ---
QIRE_ENV=$HOME/venvs/qire            # venv ODER conda-Umgebung (Pfad oder Name)
QIRE_ENV_ART=venv                    # venv | conda
QIRE_MODULE=                         # z. B. "python-waterboa cuda" -- erfragen; leer = keine module-Befehle

# --- Pfade im Projekt (relativ zu MPI_ZIEL_ORDNER oder absolut) ---
QIRE_DATEN=$MPI_ZIEL_ORDNER/INSTITUT/daten   # vorab per rsync hinlegen, Rechenknoten haben evtl. kein Internet
HF_HOME=$MPI_ZIEL_ORDNER/modelle/hf          # Modellcache fuer QLoRA (vorab befuellen)
